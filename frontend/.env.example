# Dev: /api is proxied to Django (faster, no CORS preflight).
VITE_API_BASE_URL=/api

# Railway frontend service — nginx proxies /api to Django.
# Set this on the frontend service (not in Vite):
# BACKEND_URL=https://YOUR-DJANGO-SERVICE.up.railway.app
# Example private network (same Railway project):
# BACKEND_URL=http://${{Django.RAILWAY_PRIVATE_DOMAIN}}:${{Django.PORT}}
